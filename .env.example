# Supabase Configuration (browser-safe)
VITE_SUPABASE_URL=https://ttnfdxabfkmqlqssqdep.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Stripe Payments Configuration (Optional — endpoints return 501 when unset)
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional Email (server + Vercel function only — never VITE_*).
# Supports any SMTP provider (Resend, SES, Postmark SMTP, Gmail...).
# When unset, POST /api/send-email honestly returns 501 {configured:false}.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Express server (server/index.js) — server-side only, never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGIN=http://localhost:5173
PORT=3001
