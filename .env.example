# Supabase Configuration (browser-safe)
VITE_SUPABASE_URL=https://ttnfdxabfkmqlqssqdep.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Stripe Payments Configuration (Optional — endpoints return 501 when unset)
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional Email (server + Vercel function only — never VITE_*).
# Supports any SMTP provider (Resend, SES, Postmark SMTP, Gmail...).
# When unset, POST /api/send-email honestly returns 501 {configured:false}.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# On-site AI fragrance concierge (server + Vercel function only — never VITE_*).
# Any OpenAI-compatible chat-completions endpoint works. When the key is unset,
# POST /api/ai-chat honestly returns 501 {configured:false} and the chat panel
# falls back to the human concierge. The provider key is never sent to the
# browser, and the assistant reads data with the caller's own session token so
# Postgres row-level security decides what it can see.
AI_PROVIDER_API_KEY=
AI_PROXY_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Express server (server/index.js) — server-side only, never exposed to the browser
# Only the legacy staff-admin endpoint uses this key; the AI concierge does not.
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGIN=http://localhost:5173
PORT=3001
