# HM Signature — environment configuration
#
# Rules that apply to every entry below:
#  - VITE_* variables are compiled into the browser bundle. Anything secret must
#    NOT use the VITE_ prefix.
#  - Every optional service degrades honestly: when its variables are unset the
#    related endpoint returns 501/503 with {configured:false} and the storefront
#    still loads.
#  - Never commit a filled-in copy of this file.

# ─── Supabase (browser-safe pair) ───────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Older projects still use the legacy anon key name; either is accepted.
VITE_SUPABASE_ANON_KEY=

# ─── Application identity ──────────────────────────────────────────────────
# Absolute public origin. Required for provider callbacks, emailed links and any
# server-rendered URL. In a Vercel deployment this is inferred from the request
# when unset, so set it explicitly for any other host.
APP_URL=
# Comma-separated list of allowed browser origins for the API (dev + prod hosts).
CORS_ORIGIN=http://localhost:5173
PORT=3001
# Inbox that receives website enquiries and staff-only notifications.
STORE_CONTACT_EMAIL=

# ─── Supabase service-role key (SERVER ONLY — never VITE_*) ─────────────────
# Used by server-side staff creation and by the scheduled email/outbox worker.
# Without it those endpoints report 503 {configured:false} and the rest of the
# application is unaffected.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Transactional email (SMTP) ────────────────────────────────────────────
# Works with any SMTP provider (Resend, Postmark, SES, Zoho, Gmail…). When unset,
# POST /api/send-email returns 501 {configured:false} and no delivery is claimed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Display sender, e.g. "HM Signature <orders@yourdomain.tld>"
SMTP_FROM=
# Shared secret that guards the outbox worker and the automation sweep endpoints
# (/api/email-worker and /api/automation-worker). Without it both answer 401.
EMAIL_WORKER_SECRET=
# Vercel Cron sends this automatically as "Authorization: Bearer …" when it invokes
# a cron path. Set it in Vercel before registering any cron job.
CRON_SECRET=

# ─── PayFast (provider-ready integration; sandbox first) ────────────────────
# Leave PAYFAST_MERCHANT_ID empty until the business account exists: the payment
# option then stays hidden on checkout instead of pretending to work.
PAYFAST_MERCHANT_ID=
PAYFAST_STORE_ID=
PAYFAST_MERCHANT_KEY=
# Optional passphrase. PayFast appends it to the signature base string; the same
# value must be configured in the merchant console.
PAYFAST_PASSPHRASE=
# true = sandbox/test credentials, false = live. Live requires confirmed
# credentials, registered return URLs and a completed sandbox test.
PAYFAST_SANDBOX=true
# Expected settlement/trade currency. PayFast documents ZAR only; it documents no
# PKR trade currency, so this stays ZAR unless PayFast tells you otherwise.
PAYFAST_CURRENCY=ZAR
# PKR → PAYFAST_CURRENCY rate used to convert the recorded order total on the
# server. PayFast has no PKR settlement, so a Pakistan-priced store must supply an
# explicit, business-approved rate; without it the hosted option stays hidden.
PAYFAST_PKR_TO_ZAR_RATE=
# Optional override of the documented signature field order (comma separated), for
# the rare case where PayFast support confirms a different order for the account.
PAYFAST_SIGNATURE_FIELD_ORDER=
# Reject notifications whose source address is outside PayFast's published IP
# ranges. Off by default: the ranges can change, and a false rejection fails
# payments silently. The cryptographic postback is always required instead.
PAYFAST_REQUIRE_ITN_NETWORK=false

# ─── AI concierge (server only — never VITE_*) ─────────────────────────────
# Any OpenAI-compatible chat-completions endpoint. When unset, /api/ai-chat
# returns 501 {configured:false} and the chat panel hands the customer to the
# human concierge instead of inventing answers.
AI_PROVIDER_API_KEY=
AI_PROXY_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ─── Error monitoring (optional) ───────────────────────────────────────────
# Both are off unless a DSN is supplied; the app never requires them to boot.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Any HTTP endpoint that accepts a JSON error report (S3/Slack/Datadog event
# hook…). Receives only { route, requestId, message, name, status, environment } —
# never request bodies, tokens, addresses or payment references. When unset,
# failures are logged in the platform log and counted on /api/health only.
ERROR_REPORT_URL=

# ─── Test suite only (never used in the app) ───────────────────────────────
# Throwaway accounts for the row-level-security and Phase 3/4 suites. Without
# them those suites skip loudly instead of reporting false passes.
SUITE_A_EMAIL=
SUITE_A_PASSWORD=
SUITE_B_EMAIL=
SUITE_B_PASSWORD=
SUITE_STAFF_EMAIL=
SUITE_STAFF_PASSWORD=
